{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "Returns 200 if the process is up and running.",
        "operationId": "HealthController_getLive",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Checks database and Redis connectivity. Returns 200 if ready, 503 if any service is down.",
        "operationId": "HealthController_getReady",
        "parameters": [],
        "responses": {
          "200": {
            "description": "All dependencies are healthy"
          },
          "503": {
            "description": "One or more dependencies are unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/v1/diagnostic/hop-trace": {
      "get": {
        "description": "Returns hop count and truncated IP hash prefix for ingress calibration. Never exposes raw IP addresses.",
        "operationId": "DiagnosticController_getHopTrace",
        "parameters": [
          {
            "name": "x-forwarded-for",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hop trace diagnostic metadata"
          },
          "404": {
            "description": "Diagnostic endpoints are disabled in production"
          }
        },
        "summary": "Diagnostic hop trace (staging/dev only)",
        "tags": [
          "Diagnostic"
        ]
      }
    },
    "/api/v1/public/contact": {
      "post": {
        "description": "Registers an institutional contact inquiry from the public marketing website.",
        "operationId": "PublicController_submitContact",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactLeadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Inquiry received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicLeadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid submission (RFC 9457)"
          },
          "413": {
            "description": "Payload too large (>16 kB) (RFC 9457)"
          },
          "422": {
            "description": "Unprocessable entity - idempotency key payload mismatch (RFC 9457)"
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457)"
          }
        },
        "summary": "Submit contact inquiry",
        "tags": [
          "Public"
        ]
      }
    },
    "/api/v1/public/demo": {
      "post": {
        "description": "Schedules an educational product walkthrough and demo preview.",
        "operationId": "PublicController_submitDemo",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLeadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Demo request received successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicLeadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid submission (RFC 9457)"
          },
          "413": {
            "description": "Payload too large (>16 kB) (RFC 9457)"
          },
          "422": {
            "description": "Unprocessable entity - idempotency key payload mismatch (RFC 9457)"
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457)"
          }
        },
        "summary": "Request institutional demo",
        "tags": [
          "Public"
        ]
      }
    },
    "/api/v1/public/newsletter": {
      "post": {
        "description": "Registers an email address for product release updates and announcements.",
        "operationId": "PublicController_submitNewsletter",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewsletterLeadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscribed to updates successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicLeadResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid submission (RFC 9457)"
          },
          "413": {
            "description": "Payload too large (>16 kB) (RFC 9457)"
          },
          "422": {
            "description": "Unprocessable entity - idempotency key payload mismatch (RFC 9457)"
          },
          "429": {
            "description": "Rate limit exceeded (RFC 9457)"
          }
        },
        "summary": "Subscribe to product updates",
        "tags": [
          "Public"
        ]
      }
    }
  },
