{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        }
      }
    ]
  },
  "transformIgnorePatterns": ["node_modules/(?!(\\.pnpm/)?jose)"],
  "testEnvironment": "node",
  "maxWorkers": 1,
  "verbose": true,
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  }
}
