# ProgressEye API — Environment Configuration

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database (Supabase PostgreSQL / Local PostgreSQL)
# For Supabase Cloud:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# For Local Docker Compose fallback:
DATABASE_URL=postgresql://progresseye:progresseye@localhost:5432/progresseye_dev?schema=public
DIRECT_URL=postgresql://progresseye:progresseye@localhost:5432/progresseye_dev?schema=public

# Supabase Project Credentials (optional for local, set for cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Redis (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Throttler / Rate Limiting (window ms, limit requests per window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=progress-eye-dev-access-secret-32ch
JWT_REFRESH_SECRET=progress-eye-dev-refresh-secret-32c

# Public Leads & Anti-Abuse
# Secret for HMAC IP hashing (prevents rainbow table attacks on logged/stored IP hashes)
LEAD_IP_HMAC_SECRET=dev-lead-ip-hmac-secret
# Turnstile spam verification (default false for local/dev, true for production)
TURNSTILE_ENABLED=false
# Cloudflare Turnstile documented test secret key (always passes)
# Documented at: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Notification & Email (Mailpit local default: localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@progresseye.com
# Notification recipient for institutional inquiries
LEAD_NOTIFICATION_RECIPIENT=leads@progresseye.com
