# ProgressEye API — Environment Configuration Example
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL with RLS)
# Direct connection for migrations, pooled for app runtime
DATABASE_URL=postgresql://progresseye:progresseye@localhost:5432/progresseye_dev?schema=public
DIRECT_URL=postgresql://progresseye:progresseye@localhost:5432/progresseye_dev?schema=public

# Redis & Queues (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & JWT
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_in_production
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000
