generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, pg_trgm, btree_gist, citext]
}

// ---------------------------------------------------------
// 1. Multi-Tenant Organization (Optional Parent of Schools)
// ---------------------------------------------------------
model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  schools School[]

  @@map("organizations")
}

// ---------------------------------------------------------
// 2. Tenant Root: School
// ---------------------------------------------------------
model School {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  slug           String
  name           String
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  academicYears   AcademicYear[]
  users           User[]
  sessions        Session[]
  roles           Role[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  counters        Counter[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorSecrets    UserTwoFactorSecret[]
  recoveryCodes       UserRecoveryCode[]

  @@map("schools")
}

// ---------------------------------------------------------
// 3. Academic Years (Tenant Scoped)
// ---------------------------------------------------------
model AcademicYear {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  counters Counter[]

  @@index([schoolId])
  @@map("academic_years")
}

// ---------------------------------------------------------
// 4. Users (Tenant Scoped)
// ---------------------------------------------------------
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  email        String    @db.Citext
  phone        String?
  passwordHash        String?   @map("password_hash")
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  isActive            Boolean   @default(true) @map("is_active")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  emailVerifiedAt     DateTime? @map("email_verified_at")
  isTwoFactorEnabled  Boolean   @default(false) @map("is_two_factor_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions  Session[]
  userRoles UserRole[]
  auditLogs AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorSecret         UserTwoFactorSecret?
  recoveryCodes           UserRecoveryCode[]

  @@index([schoolId])
  @@map("users")
}

// ---------------------------------------------------------
// 5. Sessions (Tenant Scoped, Immutable/Revocable)
// ---------------------------------------------------------
model Session {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  familyId        String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  parentTokenHash String?   @map("parent_token_hash")
  tokenHash       String    @unique @map("token_hash")
  clientType      String    @default("web") @map("client_type")
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@index([schoolId, familyId])
  @@map("sessions")
}

// ---------------------------------------------------------
// 6. Roles (Tenant Scoped)
// ---------------------------------------------------------
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  name        String
  slug        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([schoolId])
  @@map("roles")
}

// ---------------------------------------------------------
// 7. Permissions (Global System Catalog)
// ---------------------------------------------------------
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ---------------------------------------------------------
// 8. Role Permissions (Tenant Scoped Junction)
// ---------------------------------------------------------
model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([schoolId, roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------
// 9. User Roles (Tenant Scoped Junction)
// ---------------------------------------------------------
model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------
// 10. Audit Logs (Tenant Scoped, Partitioned by Month)
// ---------------------------------------------------------
model AuditLog {
  id         String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------
// 11. Outbox Events (Tenant Scoped, State Machine)
// ---------------------------------------------------------
model OutboxEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("PENDING")
  retryCount  Int       @default(0) @map("retry_count")
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("outbox_events")
}

// ---------------------------------------------------------
// 12. Counters (Tenant Scoped, High Concurrency Row Locks)
// ---------------------------------------------------------
model Counter {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  academicYearId String?       @map("academic_year_id") @db.Uuid
  sequenceName   String        @map("sequence_name")
  currentValue   BigInt        @default(0) @map("current_value")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([schoolId, sequenceName])
  @@map("counters")
}

// ---------------------------------------------------------
// Platform / Marketing Leads (Outside RLS, No school_id)
// ---------------------------------------------------------
enum LeadType {
  CONTACT
  DEMO
  NEWSLETTER

  @@map("lead_types")
}

enum LeadStatus {
  NEW
  CONTACTED
  ARCHIVED

  @@map("lead_statuses")
}

model Lead {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LeadType
  name           String?
  email          String      @db.Citext
  schoolName     String?     @map("school_name")
  message        String?
  status         LeadStatus  @default(NEW)
  consentText    String      @map("consent_text")
  consentedAt    DateTime    @default(now()) @map("consented_at")
  ipAddressHash  String?     @map("ip_address_hash")
  userAgent      String?     @map("user_agent")
  idempotencyKey String?     @unique @map("idempotency_key")
  retentionUntil DateTime?   @map("retention_until")
  notifiedAt     DateTime?   @map("notified_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([type, createdAt])
  @@index([email])
  @@index([status])
  @@map("public_leads")
}

// ---------------------------------------------------------
// 13. Password Reset Tokens (Tenant Scoped, Single-Use)
// ---------------------------------------------------------
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------
// 14. Email Verification Tokens (Tenant Scoped, Single-Use)
// ---------------------------------------------------------
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------
// 15. Two-Factor Authentication Secrets (Tenant Scoped, Encrypted)
// ---------------------------------------------------------
model UserTwoFactorSecret {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  encryptedSecret String    @map("encrypted_secret")
  iv              String    @map("iv")
  authTag         String    @map("auth_tag")
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, userId])
  @@map("user_two_factor_secrets")
}

// ---------------------------------------------------------
// 16. Two-Factor Recovery Codes (Tenant Scoped, Single-Use Hashed)
// ---------------------------------------------------------
model UserRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([schoolId, userId])
  @@map("user_recovery_codes")
}


