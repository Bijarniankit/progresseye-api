{
  "name": "progresseye-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "dev:worker": "ts-node-dev src/worker.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "openapi:generate": "ts-node src/scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.0.0",
    "@scalar/nestjs-api-reference": "^1.2.28",
    "@supabase/supabase-js": "^2.117.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.0",
    "fastify": "^5.12.5",
    "ioredis": "^5.5.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^4.2.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.0"
  }
}
